{
  "name": "local-review",
  "version": "0.1.0",
  "description": "Local code review for agentic development, built on jj",
  "license": "Unlicense",
  "private": true,
  "type": "module",
  "bin": {
    "lr": "src/bin.ts"
  },
  "scripts": {
    "lr": "bun src/bin.ts",
    "test": "bun test --coverage",
    "e2e": "bun test ./e2e",
    "e2e:install": "playwright-core install --only-shell chromium",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test",
    "build": "NODE_ENV=production bun build src/bin.ts --compile --minify --outfile dist/lr"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0"
  }
}
